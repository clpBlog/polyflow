# Copy this file to .env.local and run:
# node --env-file=.env.local server.mjs
APP_NAME=PolyFlow
APP_INSTITUTION=Your University
# Recommended for containers. Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-chat

# Canvas → Account → Settings → New Access Token
CANVAS_API_TOKEN=
CANVAS_BASE_URL=https://canvas.polyu.edu.hk

# Local desktop bridge. It opens Chrome once for Canvas login and reuses that
# profile; it does not accept or save NetPassword in application code.
# Enabled automatically when the server binds to 127.0.0.1.
# CANVAS_BRIDGE_ENABLED=1
PYTHON_BIN=.venv/bin/python

# Outlook. Both connectors are local-only and enabled automatically when the server
# binds to 127.0.0.1. The Mac mail-app reader also requires macOS.
# OUTLOOK_BASE_URL=https://outlook.office.com
# OUTLOOK_BRIDGE_ENABLED=1
# OUTLOOK_LOCAL_ENABLED=1

# Set to "legacy" to serve the original single-file UI instead of web/.
# POLYFLOW_UI=legacy

# Optional. Change only if you use an approved compatible gateway.
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional local UI test without calling DeepSeek or spending tokens.
# DEEPSEEK_MOCK=1
